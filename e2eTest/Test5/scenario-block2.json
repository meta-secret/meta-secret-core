          { "platform": "web", "secret": "b" }
        ]
      },
      {
        "block": 2,
        "count": 3,
        "senders": [
          { "platform": "ios", "secret": "a" },
          { "platform": "android", "secret": "b" }
        ],
        "approvals": [
          { "platform": "ios", "secret": "b" },
          { "platform": "android", "secret": "a" }
        ]
      }
    ]
  },
  "vault": { "name": "test5-block2@test.ru" },
  "secrets": {

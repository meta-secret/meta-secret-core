{
  "runId": "test43",
  "testNumber": 43,
  "name": "Test #43 — distributed Secret creators, iOS removal requester, Android survivor",
  "mode": "web-distributed-creator-member-removal-lifecycle",
  "description": "Web creates the Vault and Secret1, Android creates Secret2, iOS creates Secret3, iOS removes Web through Android approval, then Android locally removes iOS and remains able to Show every Secret.",
  "setup": {
    "initiator": "web",
    "joinOrder": ["android", "ios"],
    "secondJoinApprover": "web"
  },
  "server": {
    "environment": "local",
    "url": "http://127.0.0.1:3000",
    "image": "ghcr.io/meta-secret/meta-secret-core/meta-secret-server:latest",
    "container": "meta-secret-e2e-server-test43",
    "port": 3000
  },
  "web": {
    "url": "http://localhost:5173",
    "directory": "../meta-secret/web-cli/ui",
    "role": "A"
  },
  "android": {
    "role": "B",
    "avdName": "Pixel_4a",
    "bundleId": "metasecret.project.com",
    "testClass": "metasecret.project.com.CaseEightAndroidBothOfflineTest",
    "directInstrumentationSetup": true,
    "joinTestMethod": "joinWebInitiatedVaultForTest43",
    "creatorTestClass": "metasecret.project.com.Case25AndroidSecondaryCreatorTest",
    "createSecretTestMethod": "createSecretForTest43",
    "lifecycleTestClass": "metasecret.project.com.Case37AndroidMemberRemovalTest",
    "approveRemovalTestMethod": "approveWebRemovalForTest43",
    "showSecretTestMethod": "showLocalSecretForTest43",
    "localRemovalTestMethod": "removeIosLocallyForTest43"
  },
  "ios": {
    "role": "C",
    "scheme": "iosApp",
    "composeRoot": "../../meta-secret-compose",
    "simulatorName": "iPhone 17",
    "bundleId": "org.metasecret.vault",
    "reuseBuildForTesting": true,
    "testClass": "CaseEightIosBothOfflineUITest",
    "joinTestMethod": "joinWebInitiatedVaultForTest43",
    "createSecretTestMethod": "createSecretForTest43",
    "requestRemovalTestMethod": "requestWebRemovalForTest43",
    "showSecretTestMethod": "showLocalSecretForTest43",
    "removalObserverTestMethod": "observeOwnRemovalForTest43"
  },
  "secretCreation": {
    "initial": { "web": ["secret1"] },
    "afterAndroidJoin": { "android": ["secret2"] },
    "afterIosJoin": { "ios": ["secret3"] }
  },
  "membership": {
    "initialPlatforms": ["web", "android", "ios"],
    "firstRemoval": {
      "requester": "ios",
      "approver": "android",
      "target": "web",
      "expectedMemberCount": 2
    },
    "secondRemoval": {
      "requester": "android",
      "approver": null,
      "target": "ios",
      "expectedMemberCount": 1
    }
  },
  "recovery": {
    "showTimeoutMs": 45000,
    "expectedCycles": 9,
    "expectedDirectShowCycles": 9,
    "expectedRecoveryCycles": 0,
    "cyclePlan": [
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret1" }] },
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret2" }] },
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret3" }] },
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "ios", "secret": "secret1" }] },
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "ios", "secret": "secret2" }] },
      { "block": "after-web-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "ios", "secret": "secret3" }] },
      { "block": "after-ios-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret1" }] },
      { "block": "after-ios-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret2" }] },
      { "block": "after-ios-removal", "mode": "direct-show", "count": 1, "senders": [{ "platform": "android", "secret": "secret3" }] }
    ]
  },
  "vault": { "name": "test43@test.ru" },
  "secrets": {
    "secret1": { "name": "test43-secret1", "value": "test43-secret1-value" },
    "secret2": { "name": "test43-secret2", "value": "test43-secret2-value" },
    "secret3": { "name": "test43-secret3", "value": "test43-secret3-value" }
  }
}

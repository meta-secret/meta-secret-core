{
  "runId": "test23",
  "testNumber": 23,
  "name": "Test #23 — Android/iOS/Web multi-secret sequential recovery",
  "mode": "android-multi-secret-lifecycle",
  "description": "Android is initiator A, iOS joins first as B, and Web joins second as C. Secret1 is created by Android before the first join, Secret2 after iOS joins, and Secret3 after the recovery stage.",
  "setup": {
    "initiator": "android",
    "joinOrder": ["ios", "web"],
    "deferredJoinAfterCycle": 12,
    "secretCreator": "android"
  },
  "server": {
    "environment": "local",
    "url": "http://127.0.0.1:3000",
    "image": "ghcr.io/meta-secret/meta-secret-core/meta-secret-server:latest",
    "container": "meta-secret-e2e-server-test23",
    "port": 3000
  },
  "web": {
    "url": "http://localhost:5173",
    "directory": "../meta-secret/web-cli/ui",
    "role": "C",
    "joinTestMethod": "joinWebInitiatedVault",
    "stepTestMethod": "handleRecoveryStep"
  },
  "ios": {
    "role": "B",
    "device": "iPhone 17",
    "scheme": "iosApp",
    "composeRoot": "../../meta-secret-compose",
    "simulatorName": "iPhone 17",
    "bundleId": "org.metasecret.vault",
    "testClass": "CaseEightIosBothOfflineUITest",
    "joinTestMethod": "joinWebInitiatedVault",
    "stepTestMethod": "handleRecoveryStep"
  },
  "android": {
    "role": "A",
    "avdName": "Pixel_4a",
    "bundleId": "metasecret.project.com",
    "device": "Pixel_4a",
    "testClass": "metasecret.project.com.CaseEightAndroidBothOfflineTest",
    "directInstrumentationSetup": true,
    "initiatorSetupTestClass": "metasecret.project.com.Case23AndroidInitiatorTest",
    "initiatorSetupTestMethod": "createVaultForTest23",
    "initiatorTestMethod": "createVaultAndRunMultiSecretLifecycle",
    "joinTestMethod": "joinWebInitiatedVault",
    "stepTestMethod": "handleRecoveryStep"
  },
  "secretCreation": {
    "initial": {
      "android": ["secret1"]
    },
    "afterIosJoin": {
      "android": ["secret2"]
    },
    "afterRecovery": {
      "android": ["secret3"]
    }
  },
  "recovery": {
    "expectedCycles": 39,
    "expectedRecoveryCycles": 27,
    "createSecret2AfterCycle": 6,
    "joinWebAfterCycle": 12,
    "createSecret3AfterCycle": 30,
    "cyclePlan": [
      {
        "block": "secret1-two-device",
        "mode": "direct-show",
        "count": 3,
        "senders": [{ "platform": "android", "secret": "secret1" }]
      },
      {
        "block": "secret1-two-device",
        "mode": "direct-show",
        "count": 3,
        "senders": [{ "platform": "ios", "secret": "secret1" }]
      },
      {
        "block": "secret2-two-device",
        "mode": "direct-show",
        "count": 3,
        "senders": [{ "platform": "android", "secret": "secret2" }]
      },
      {
        "block": "secret2-two-device",
        "mode": "direct-show",
        "count": 3,
        "senders": [{ "platform": "ios", "secret": "secret2" }]
      },
      {
        "block": "secret1-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "android", "secret": "secret1" }],
        "approvals": [{ "platform": "ios", "secret": "secret1" }]
      },
      {
        "block": "secret1-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "ios", "secret": "secret1" }],
        "approvals": [{ "platform": "web", "secret": "secret1" }]
      },
      {
        "block": "secret1-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "web", "secret": "secret1" }],
        "approvals": [{ "platform": "android", "secret": "secret1" }]
      },
      {
        "block": "secret2-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "android", "secret": "secret2" }],
        "approvals": [{ "platform": "web", "secret": "secret2" }]
      },
      {
        "block": "secret2-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "ios", "secret": "secret2" }],
        "approvals": [{ "platform": "android", "secret": "secret2" }]
      },
      {
        "block": "secret2-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "web", "secret": "secret2" }],
        "approvals": [{ "platform": "ios", "secret": "secret2" }]
      },
      {
        "block": "secret3-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "android", "secret": "secret3" }],
        "approvals": [{ "platform": "ios", "secret": "secret3" }]
      },
      {
        "block": "secret3-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "ios", "secret": "secret3" }],
        "approvals": [{ "platform": "web", "secret": "secret3" }]
      },
      {
        "block": "secret3-three-device",
        "mode": "recovery",
        "count": 3,
        "senders": [{ "platform": "web", "secret": "secret3" }],
        "approvals": [{ "platform": "android", "secret": "secret3" }]
      }
    ]
  },
  "vault": {
    "name": "test23@test.ru"
  },
  "secrets": {
    "secret1": { "name": "test23-secret1", "value": "test23-secret1-value" },
    "secret2": { "name": "test23-secret2", "value": "test23-secret2-value" },
    "secret3": { "name": "test23-secret3", "value": "test23-secret3-value" }
  }
}

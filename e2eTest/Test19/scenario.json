{
  "runId": "test19",
  "testNumber": 19,
  "name": "Test #19 — multiple Web tabs",
  "mode": "multiple-web-tabs",
  "setup": { "initiator": "web" },
  "server": {
    "url": "http://127.0.0.1:3000",
    "image": "ghcr.io/meta-secret/meta-secret-core/meta-secret-server:latest",
    "container": "meta-secret-e2e-server-test19",
    "port": 3000
  },
  "web": { "url": "http://localhost:5173", "directory": "../meta-secret/web-cli/ui" },
  "ios": {
    "composeRoot": "../../meta-secret-compose",
    "simulatorName": "iPhone 17",
    "bundleId": "org.metasecret.vault",
    "testClass": "CaseEightIosBothOfflineUITest",
    "joinTestMethod": "joinWebInitiatedVault",
    "stepTestMethod": "handleRecoveryStep"
  },
  "android": {
    "avdName": "Pixel_4a",
    "bundleId": "metasecret.project.com",
    "testClass": "metasecret.project.com.CaseEightAndroidBothOfflineTest",
    "testMethod": "joinWebInitiatedVault",
    "directInstrumentationSetup": true,
    "stepTestMethod": "handleRecoveryStep"
  },
  "recovery": {
    "expectedCycles": 3,
    "cyclePlan": [
      {
        "block": "ios-sender-web-tabs",
        "count": 1,
        "senders": [{ "platform": "ios", "secret": "default" }],
        "approvals": [{ "platform": "web", "secret": "default", "action": "approve" }]
      },
      {
        "block": "android-sender-web-tabs",
        "count": 1,
        "senders": [{ "platform": "android", "secret": "default" }],
        "approvals": [{ "platform": "web", "secret": "default", "action": "approve" }]
      },
      {
        "block": "ios-sender-web-tabs-repeat",
        "count": 1,
        "senders": [{ "platform": "ios", "secret": "default" }],
        "approvals": [{ "platform": "web", "secret": "default", "action": "approve" }]
      }
    ]
  },
  "vault": { "name": "test19@test.ru" },
  "secrets": { "default": { "name": "test-secret", "value": "test-secret-value" } }
}

{
  "runId": "test33",
  "testNumber": 33,
  "name": "Test #33 — iOS owner, Web-only second Join approval, three Secret creators",
  "mode": "ios-two-secret-owner-lifecycle",
  "description": "iOS creates Vault and Secret1, Web joins, iOS creates Secret2, and Web exclusively approves Android joining. Secret1 and Secret2 are recovered in cycles 1-18; iOS creates Secret3 at the completed cycle-18 boundary, then all three Secrets are recovered through cycle 27.",
  "setup": {
    "initiator": "ios",
    "joinOrder": ["web", "android"],
    "secondarySecretCreator": "ios",
    "thirdSecretCreator": "ios",
    "secondJoinApprover": "web"
  },
  "server": {
    "environment": "local",
    "url": "http://127.0.0.1:3000",
    "image": "ghcr.io/meta-secret/meta-secret-core/meta-secret-server:latest",
    "container": "meta-secret-e2e-server-test33",
    "port": 3000
  },
  "web": {
    "url": "http://localhost:5173",
    "directory": "../meta-secret/web-cli/ui",
    "role": "B"
  },
  "ios": {
    "role": "A",
    "device": "iPhone 17",
    "scheme": "iosApp",
    "composeRoot": "../../meta-secret-compose",
    "simulatorName": "iPhone 17",
    "bundleId": "org.metasecret.vault",
    "testClass": "CaseEightIosBothOfflineUITest",
    "initiatorSetupTestMethod": "createVaultForTest33",
    "approveJoinTestMethod": "approvePendingJoinForTest33",
    "createSecretTestMethod": "createSecretForTest33",
    "redistributionCheckTestMethod": "assertSecretVisibleForTest33",
    "stepTestMethod": "handleRecoveryStep"
  },
  "android": {
    "role": "C",
    "avdName": "Pixel_4a",
    "bundleId": "metasecret.project.com",
    "device": "Pixel_4a",
    "testClass": "metasecret.project.com.CaseEightAndroidBothOfflineTest",
    "directInstrumentationSetup": true,
    "joinTestMethod": "joinWebInitiatedVault",
    "redistributionCheckTestMethod": "assertSecretVisibleForTest33",
    "stepTestMethod": "handleRecoveryStep"
  },
  "secretCreation": {
    "initial": { "ios": ["secret1"] },
    "afterWebJoin": { "ios": ["secret2"] },
    "afterRecovery": { "ios": ["secret3"] }
  },
  "recovery": {
    "showTimeoutMs": 45000,
    "expectedCycles": 27,
    "expectedDirectShowCycles": 0,
    "expectedRecoveryCycles": 27,
    "createSecret3AfterCycle": 18,
    "expectedRoleCountPerPlatform": 9,
    "cyclePlan": [
      { "block": "secret1-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "ios", "secret": "secret1" }], "approvals": [{ "platform": "web", "secret": "secret1" }], "observer": "android" },
      { "block": "secret1-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "web", "secret": "secret1" }], "approvals": [{ "platform": "android", "secret": "secret1" }], "observer": "ios" },
      { "block": "secret1-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "android", "secret": "secret1" }], "approvals": [{ "platform": "ios", "secret": "secret1" }], "observer": "web" },
      { "block": "secret2-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "ios", "secret": "secret2" }], "approvals": [{ "platform": "web", "secret": "secret2" }], "observer": "android" },
      { "block": "secret2-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "web", "secret": "secret2" }], "approvals": [{ "platform": "android", "secret": "secret2" }], "observer": "ios" },
      { "block": "secret2-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "android", "secret": "secret2" }], "approvals": [{ "platform": "ios", "secret": "secret2" }], "observer": "web" },
      { "block": "secret3-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "ios", "secret": "secret3" }], "approvals": [{ "platform": "web", "secret": "secret3" }], "observer": "android" },
      { "block": "secret3-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "web", "secret": "secret3" }], "approvals": [{ "platform": "android", "secret": "secret3" }], "observer": "ios" },
      { "block": "secret3-three-device", "mode": "recovery", "count": 3, "senders": [{ "platform": "android", "secret": "secret3" }], "approvals": [{ "platform": "ios", "secret": "secret3" }], "observer": "web" }
    ]
  },
  "vault": { "name": "test33@test.ru" },
  "secrets": {
    "secret1": { "name": "test33-secret1", "value": "test33-secret1-value" },
    "secret2": { "name": "test33-secret2", "value": "test33-secret2-value" },
    "secret3": { "name": "test33-secret3", "value": "test33-secret3-value" }
  }
}

# Public browser provider settings. Merge these lines into .env.local;
# preserve its existing Core endpoint/environment settings. Restart Vite.
# Google: reuse the Web client used by Android GOOGLE_SERVER_CLIENT_ID after
# checking its authorized JavaScript origins in Google Cloud.
VITE_GOOGLE_WEB_CLIENT_ID=
# Apple: confirmed HTTPS origin of the existing server with the email broker.
# Server configuration owns Services ID and registered /apple/callback URL.
# Leave empty until that backend is configured/deployed; github.io is not a POST receiver.
VITE_APPLE_EMAIL_BROKER_URL=
# Client secrets, .p8 private keys and refresh tokens never belong here.
